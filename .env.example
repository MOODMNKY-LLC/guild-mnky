# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-service-role-key

# Notion
NOTION_API_KEY=your-notion-integration-token
NOTION_GUIDES_DATABASE_ID=your-notion-guides-database-id
NOTION_SYNC_SECRET=optional-sync-secret

# Supabase Management API Token (for Platform Kit)
# Get your token from: https://supabase.com/dashboard/account/tokens
# Note: Management API is designed for cloud projects. Local development may have limited functionality.
SUPABASE_MANAGEMENT_API_TOKEN=your-management-api-token-here

# Multi-Community Support
# Default anchor guild ID used as fallback when user's Discord guild cannot be determined
DEFAULT_ANCHOR_GUILD_ID=573823015511392268
# Sherpa Hub Discord guild ID
SHERPA_HUB_GUILD_ID=1291190711919837234
